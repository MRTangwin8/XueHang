# 复制为 .env 后修改
DATABASE_URL="file:./prisma/dev.db"
# 生产环境必须设置 32 位以上随机字符串，否则服务拒绝启动
JWT_SECRET=""
PORT=3001
# 数据库连接池上限（MySQL / PostgreSQL），默认 10
# DB_POOL_MAX=10
# NODE_ENV=production
# 数据目录（可选，Docker 镜像默认 /data）：必须作为真实环境变量设置，不能写在本文件里。
# 设置后 .env、SQLite 数据库、上传文件、安装码都放在该目录。
# DATA_DIR=/data
# 部署在 Nginx 等反向代理之后时开启，否则不要开
# TRUST_PROXY=1
# 仅在前端与 API 不同源时设置，多个用逗号分隔
# CORS_ORIGIN=https://crm.example.com
