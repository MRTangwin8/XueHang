    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@types/nodemailer": "^8.0.2",
    "bcryptjs": "^3.0.3",
    "dayjs": "^1.11.13",
    "exceljs": "^4.4.0",
    "fastify": "^5.2.1",
    "fastify-plugin": "^6.0.1",
    "nodemailer": "^10.4.0",
    "prisma": "^7.10.1",
    "tsx": "^4.19.2",
    "uuid": "^11.1.1",
    "zod": "^4.6.7"
  },
